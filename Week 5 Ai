        "from torch.utils.data import Dataset\n",
        "from torch.utils.data import DataLoader, WeightedRandomSampler\n",
        "import torchvision.transforms.functional as ttf\n",
        "import pandas as pd\n",
        "import torchvision.transforms as T\n",
        "import torch\n",
        "from PIL import Image\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "class LiTS_Dataset(Dataset):\n",
        "\n",
        "    def __init__(self, csv: str, mode: str, transform=None):\n",
        "\n",
        "        self.csv = csv\n",
        "        self.transform = transform\n",
        "        self.data = pd.read_csv(self.csv)\n",
        "        self.mode = mode\n",
        "        assert mode in [\"train\", \"val\", \"test\"]\n",
        "\n",
        "    def __len__(self):\n",
        "\n",
        "        return len(self.data)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "\n",
        "        file = self.data.loc[idx, \"filename\"]\n",
        "        with Image.open(f\"./Clean_LiTS/{self.mode}/{file}\") as f:\n",
        "            f = f.convert(\"L\")\n",
        "            image = ttf.pil_to_tensor(f)   # [1,H,W]\n",
        "\n",
        "        image = image.to(dtype=torch.float32)\n",
        "\n",
        "        mean = image.mean()\n",
        "        std = image.std()\n",
        "\n",
        "        if std > 0:\n",
        "          image = (image - mean) / std\n",
        "        else:\n",
        "          image = image - mean\n",
        "\n",
        "\n",
        "\n",
        "        _, H, W = image.shape\n",
        "        image = image[:, :, W // 2:]\n",
        "\n",
        "        liver_visible  = int(self.data.loc[idx, \"liver_visible\"])\n",
        "        lesion_visible = int(self.data.loc[idx, \"lesion_visible\"])\n",
        "\n",
        "        # multi-label: [liver, tumor]\n",
        "        target = torch.tensor([liver_visible, lesion_visible],\n",
        "                              dtype=torch.float32)\n",
        "\n",
        "        if self.transform:\n",
        "            image = self.transform(image)\n",
        "\n",
        "        return image, target\n",
        "\n",
        "train_tf = T.Compose([\n",
        "    T.RandomRotation(0),\n",
        "    T.RandomRotation(10),\n",
        "    T.RandomVerticalFlip(),\n",
        "    T.RandomAffine(10, scale=(0.95, 1.05)),\n",
        "])\n",
        "\n",
        "train_ds = LiTS_Dataset(\"/content/Clean_LiTS/train_classes.csv\", mode=\"train\")\n",
        "val_ds   = LiTS_Dataset(\"/content/Clean_LiTS/val_classes.csv\",   mode=\"val\")\n",
        "test_ds  = LiTS_Dataset(\"/content/Clean_LiTS/test_classes.csv\",  mode=\"test\")\n",
        "\n",
        "\n",
        "labels = []\n",
        "for idx, row in train_ds.data.iterrows():\n",
        "    liver_visible  = int(row[\"liver_visible\"])\n",
        "    lesion_visible = int(row[\"lesion_visible\"])\n",
        "\n",
        "    if liver_visible == 0:\n",
        "        labels.append(0)      # keine Leber\n",
        "    elif lesion_visible == 0:\n",
        "        labels.append(1)      # Leber, kein Tumor\n",
        "    else:\n",
        "        labels.append(2)      # Leber + Tumor\n",
        "\n",
        "labels = np.array(labels)\n",
        "\n",
        "class_counts = np.bincount(labels)\n",
        "print(\"Klassenhäufigkeiten:\", class_counts)\n",
        "\n",
        "\n",
        "\n",
        "class_weights = 1.0 / np.sqrt(class_counts)\n",
        "class_weights = class_weights / class_weights.sum()  # normalisieren\n",
        "\n",
        "print(\"Class Weights:\", class_weights)\n",
        "\n",
        "\n",
        "sample_weights = class_weights[labels]\n",
        "sample_weights = torch.tensor(sample_weights, dtype=torch.float32)\n",
        "\n",
        "\n",
        "sampler = WeightedRandomSampler(\n",
        "    weights=sample_weights,\n",
        "    num_samples=len(sample_weights),\n",
        "    replacement=True\n",
        ")\n"
      ]
